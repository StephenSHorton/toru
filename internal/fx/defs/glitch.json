{
  "type": "glitch",
  "version": 1,
  "name": "Glitch",
  "category": "stylize",
  "kind": "neighbourhood",
  "params": [
    { "id": "density", "label": "Amount", "type": "number", "min": 0, "max": 1, "default": 0.35, "step": 0.01, "display": "percent", "animate": false,
      "hint": "How much of the time is glitching" },
    { "id": "rate", "label": "Speed", "type": "number", "min": 1, "max": 30, "default": 10, "step": 1, "unit": "Hz", "animate": false,
      "hint": "How many times a second the glitch changes" },
    { "id": "shift", "label": "Colour split", "type": "number", "min": 0, "max": 60, "default": 10, "step": 0.5, "unit": "px", "animate": false },
    { "id": "slices", "label": "Slices", "type": "number", "min": 0, "max": 6, "default": 4, "step": 1, "animate": false },
    { "id": "sliceShift", "label": "Slice offset", "type": "number", "min": 0, "max": 300, "default": 80, "step": 1, "unit": "px", "animate": false },
    { "id": "sliceSize", "label": "Slice height", "type": "number", "min": 0.02, "max": 0.25, "default": 0.06, "step": 0.01, "display": "percent", "animate": false },
    { "id": "noise", "label": "Noise", "type": "number", "min": 0, "max": 1, "default": 0.25, "step": 0.01, "display": "percent", "animate": false },
    { "id": "seed", "label": "Variation", "type": "number", "min": 0, "max": 9999, "default": 3, "step": 1, "animate": false }
  ],
  "export": { "filters": ["rgbashift", "split", "crop", "overlay", "noise"] },
  "parity": { "mode": "pixels", "mean": 1, "p99": 6 },
  "amount": "blend"
}
