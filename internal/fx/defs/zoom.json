{
  "type": "zoom",
  "version": 1,
  "name": "Zoom",
  "category": "distort",
  "kind": "geometry",
  "params": [
    { "id": "scale", "label": "Zoom", "type": "number", "min": 1, "max": 4, "default": 1.5, "step": 0.01, "unit": "×", "animate": false },
    { "id": "center", "label": "Centre", "type": "point", "default": [0.5, 0.5], "animate": false,
      "hint": "The point the zoom moves towards; pick it on the player" },
    { "id": "start", "label": "Start", "type": "number", "min": 0, "max": 3600, "default": 0, "step": 0.01, "unit": "s", "animate": false,
      "hint": "Seconds from the clip's start" },
    { "id": "in", "label": "Zoom in", "type": "number", "min": 0, "max": 10, "default": 0.3, "step": 0.01, "unit": "s", "animate": false },
    { "id": "hold", "label": "Hold", "type": "number", "min": 0, "max": 3600, "default": 1, "step": 0.01, "unit": "s", "animate": false },
    { "id": "out", "label": "Zoom out", "type": "number", "min": 0, "max": 10, "default": 0.3, "step": 0.01, "unit": "s", "animate": false },
    { "id": "ease", "label": "Easing", "type": "enum", "default": "inOut", "animate": false,
      "options": [ { "id": "linear", "label": "Linear" }, { "id": "in", "label": "Ease in" }, { "id": "out", "label": "Ease out" }, { "id": "inOut", "label": "Ease in/out" } ] }
  ],
  "export": { "filters": ["scale", "crop"] },
  "parity": { "mode": "pixels", "mean": 1, "p99": 6 },
  "amount": "blend"
}
