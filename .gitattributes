# Normalize line endings: LF in the repo, checkout native on Windows.
* text=auto

# Go and shell scripts stay LF.
*.go text eol=lf
*.sh text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Generated by the build (wails3 generate bindings, go mod tidy), which writes
# LF: keep them LF on checkout too, so a build leaves git status clean.
frontend/bindings/** text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.mp4 binary
*.ico binary
*.icns binary
*.ttf binary
*.exe binary
*.wav binary
